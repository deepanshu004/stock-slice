    "@types/luxon": "^3.6.2",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "vitest": "^4.1.12"
  }
